@{
    // the text in the browser tab
    ViewData["Title"] = "Sign up";

    // this page has no sidebar, so it uses the other frame: Shared/_AccountLayout.cshtml
    Layout = "_AccountLayout";
}

@* links this page's own css file, wwwroot/css/pages/account.css *@
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css">
}

<div class="account-header">
    <h1>Hello, welcome to Miko lab!</h1>
    <p>Create an account to continue</p>
</div>

<form method="post" class="card stack account-form">
    <label class="field">
        <span>Email</span>
        <input type="email" name="Email" autocomplete="email">
    </label>
    <label class="field">
        <span>Username</span>
        <input type="text" name="Username" autocomplete="username">
    </label>
    <label class="field">
        <span>Password</span>
        <input type="password" name="Password" autocomplete="new-password">
    </label>
    <label class="field">
        <span>Repeat password</span>
        <input type="password" name="RepeatPassword" autocomplete="new-password">
    </label>
    <button type="submit" class="button account-button">Sign up</button>
    <p class="divider">or</p>
    <p class="switch">Already have an account? <a href="/Account/SignIn">Sign in</a></p>
</form>