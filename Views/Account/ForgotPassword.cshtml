@{
    // the text in the browser tab
    ViewData["Title"] = "Forgot password";

    // this page has no sidebar, so it uses the other frame: Shared/_AccountLayout.cshtml
    Layout = "_AccountLayout";
}

@* links this page's own css file, wwwroot/css/pages/account.css *@
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css">
}

<div class="account-header">
    <h1>Forgot your password?</h1>
    <p>Enter the email associated with your account and we'll send you password reset instructions</p>
</div>

<form method="post" class="card stack account-form">
    <label class="field">
        <span>Email</span>
        <input type="email" name="Email" autocomplete="email">
    </label>
    <button type="submit" class="button account-button">Send reset instructions</button>
    <p class="divider">or</p>
    <p class="switch">Go back to <a href="/Account/SignIn">Sign in</a></p>
</form>