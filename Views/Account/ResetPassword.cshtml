@{
    // the text in the browser tab
    ViewData["Title"] = "Reset password";

    // this page has no sidebar, so it uses the other frame: Shared/_AccountLayout.cshtml
    Layout = "_AccountLayout";
}

@* links this page's own css file, wwwroot/css/pages/account.css *@
@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css">
}

<div class="account-header">
    <h1>Reset your password</h1>
    <p>Enter a new password below to change your password</p>
</div>

<form method="post" class="card stack account-form">
    <label class="field">
        <span>New password</span>
        <input type="password" name="NewPassword" autocomplete="new-password">
    </label>
    <label class="field">
        <span>Re-enter new password</span>
        <input type="password" name="RepeatNewPassword" autocomplete="new-password">
    </label>
    <button type="submit" class="button account-button">Reset password</button>
</form>